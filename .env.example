# Copy to `.env` and fill in real values. NEVER commit `.env`.
# See docs/credentials.md for what each variable is and where it comes from.

# ---- Practice Fusion FHIR ----
PF_ENV=qa                          # qa | prod
PF_FHIR_BASE_URL=                  # https://qa-api.practicefusion.com/fhir/r4/v1/{org-uuid}
PF_ORG_UUID=                       # UUID of the practice in Practice Fusion
PF_CLIENT_ID=                      # From Veradigm app registration
PF_CLIENT_SECRET=                  # From Veradigm app registration — keep secret
PF_SCOPES=                         # Space-separated scope string. NOTE: do NOT include `launch` for standalone flow (PF accepts it at /authorize but rejects at /token with "Invalid launch context"). `fhirUser` is camelCase per SMART spec — `fhiruser` is rejected.
PF_REDIRECT_URI=http://localhost:8080/oauth/callback

# ---- Onboarding E2E (Layer 3 / Playwright; Session 0008) ----
# When these are set, `make test-ci-ui` exercises the real SMART
# authorization-code grant against PF QA via Playwright on port 8080
# (the Veradigm-registered redirect URI). When absent, the OAuth spec
# self-skips and the harness still boots the onboarding stack. QA-only
# — no PHI, no real practices. 2FA in PF QA is hardcoded "12345"; no
# env var needed.
PF_QA_USERNAME=                    # PF QA test-user login
PF_QA_PASSWORD=                    # PF QA test-user password

# ---- Test patients ----
PF_TEST_PATIENT_1_NAME=
PF_TEST_PATIENT_1_PHONE=
PF_TEST_PATIENT_1_DOB=
PF_TEST_PATIENT_2_NAME=
PF_TEST_PATIENT_2_PHONE=
PF_TEST_PATIENT_2_DOB=

# ---- AWS ----
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
